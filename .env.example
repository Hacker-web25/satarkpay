# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD

# AI: set one key. AI_PROVIDER is optional (nvidia | openai | gemini); AI_MODEL overrides the default model.
# Fastest free option: Gemini, key from aistudio.google.com (answers in a few seconds).
# Also free: NVIDIA, key from build.nvidia.com (starts with nvapi-). Default model: nvidia/nemotron-3.5-lightning-30b-a3b.
# Run `npm run pick-model` once to test NVIDIA's models on your key and save the fastest one here.
NVIDIA_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=
AI_MODEL=

# Payments scoring above this wait for the family guardian (0-100)
HOLD_ABOVE=39

# Saathi memory: how long to wait for the AI on a new question, and how close a saved question must be (0-1)
SAATHI_TIMEOUT_MS=45000
MEMORY_MATCH=0.5
PORT=3000
